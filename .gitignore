# Root .gitignore for Rooted Project

# Dependency directories
node_modules/
frontend/node_modules/
backend/node_modules/

# Local env files
.env
frontend/.env
backend/.env
frontend/.env*.local
backend/.env*.local

# Build outputs
frontend/dist/
backend/dist/
frontend/.expo/
frontend/web-build/
backend/dist/

# Logs and system files
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem

# Native build directories (if any generated)
frontend/ios/
frontend/android/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
