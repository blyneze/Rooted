{
  "expo": {
    "name": "Rooted",
    "slug": "rooted",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo1024.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.blyneze.rooted",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "fetch"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo1024.png",
        "backgroundColor": "#ffffff",
        "resizeMode": "contain"
      },
      "package": "com.blyneze.rooted",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-secure-store"
      ],
      "@clerk/expo",
      "expo-web-browser"
    ],
    "scheme": "rooted",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d24eaf87-7dda-4422-b89c-1570e937341d"
      }
    },
    "owner": "blyneze"
  }
}